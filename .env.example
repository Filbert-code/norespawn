# Copy this file to .env.local and fill in values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "anon" / public key (safe to expose in the browser; protected by RLS).
# Do NOT put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional: extra emails allowed to use the app (comma-separated).
# Access is fail-closed: only the built-in owner email plus anyone listed here
# can sign in; everyone else is denied. The owner is hardcoded in src/lib/auth.ts,
# so this can be left blank. Example:
# VITE_ALLOWED_EMAILS=teammate@gmail.com,other@gmail.com
VITE_ALLOWED_EMAILS=

# --- Art generation pipeline (local CLI only) -------------------------------
# fal.ai API key for scripts/gen-art.ts. NOT prefixed with VITE_ on purpose:
# it must never be bundled into the client. Get it from fal.ai -> your app keys.
FAL_KEY=
